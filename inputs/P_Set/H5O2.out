    2 H      -0.098   -1.393   -0.491   -0.103   -1.275   -0.379   -0.117   -1.092   -0.209    0.282
    3 H      -0.098   -1.389   -0.487   -0.104   -1.275   -0.378   -0.117   -1.092   -0.209    0.278
    4 O      -2.818   -3.893    1.290   -3.015   -4.024    0.961   -2.840   -4.034    1.126   -0.164
    5 H      -0.098   -1.396   -0.494   -0.104   -1.279   -0.383   -0.118   -1.096   -0.214    0.280
    6 H      -0.098   -1.400   -0.498   -0.103   -1.283   -0.386   -0.117   -1.100   -0.217    0.280
